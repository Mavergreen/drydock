{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "include": ["/usr/local/mavergreen/shipyard/share/cmake/MavericksShipyard/mavericks-presets.json"],
  "configurePresets": [
    {
      "name": "x86_64",
      "inherits": "mavericks-x86_64",
      "displayName": "x86_64 — Mac OS X 10.9, on any host, against the pinned 10.9 SDK"
    },
    {
      "name": "arm64",
      "inherits": "macos-arm64",
      "displayName": "arm64 — the arm64 slice, for 11.0, against the pinned 11.3 SDK"
    }
  ],
  "buildPresets": [
    { "name": "x86_64", "configurePreset": "x86_64" },
    { "name": "arm64", "configurePreset": "arm64" }
  ],
  "testPresets": [
    { "name": "x86_64", "configurePreset": "x86_64", "output": { "outputOnFailure": true } },
    { "name": "arm64", "configurePreset": "arm64", "output": { "outputOnFailure": true } }
  ]
}
